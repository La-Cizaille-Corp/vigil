<section class="digest">
{{with .Group}}<p><strong>Groupe {{.}}</strong> : les actifs de ce groupe et leurs vulnérabilités.</p>
{{end}}<p>Généré le {{date .GeneratedAt}} — période depuis le {{date .Since}}.</p>

<h2>Urgentes ({{.Urgent.Total}})</h2>
{{template "lines" .Urgent}}

<h2>Par niveau</h2>
<table class="breakdown">
<thead><tr><th>Niveau</th><th class="num">Nouvelles sur la période</th><th class="num">Au total</th></tr></thead>
<tbody>
{{range .Levels}}<tr><td><a href="{{$.List "level" .Level}}">{{.Label}}</a></td><td class="num">{{if .New}}<a href="{{$.List "level" .Level "since" $.SinceDays}}">{{.New}}</a>{{else}}<span class="muted">0</span>{{end}}</td><td class="num">{{.Now}}</td></tr>
{{end}}</tbody>
</table>

<h2>Nouvelles vulnérabilités ouvertes ({{.New.Total.N}})</h2>
{{if .New.Groups}}{{template "breakdown" .New}}
{{if and .New.Total.Urgent .NewListed.Lines}}<p>Les urgentes sont en tête du digest ; les autres, les plus urgentes d'abord :</p>
{{else if .New.Total.Urgent}}<p>Toutes sont urgentes, en tête du digest.</p>{{end}}
{{template "lines" .NewListed}}
{{else}}<p>Aucune nouvelle vulnérabilité ouverte sur la période.</p>{{end}}

{{if .Overdue.Total}}
<h2>Hors délai de traitement ({{.Overdue.Total}})</h2>
{{template "lines" .Overdue}}
{{end}}

{{if .Concerning}}
<h2>Actualités citant vos vulnérabilités ({{len .Concerning}})</h2>
<ul>
{{range .Concerning}}
<li>{{if .Link}}<a href="{{.Link}}" rel="noopener noreferrer" target="_blank">{{.Title}}</a>{{else}}{{.Title}}{{end}}
<small class="muted">— {{.FeedName}}, {{date .Published}} · {{join .Concerns ", "}}</small></li>
{{end}}
</ul>
{{end}}

<h2>Vulnérabilités ouvertes ({{.Open.Total.N}})</h2>
{{if .Open.Groups}}
{{template "breakdown" .Open}}
<p><a href="{{.List}}">La liste des {{.Open.Total.N}} vulnérabilités ouvertes</a></p>
{{else}}
<p>Aucune vulnérabilité ouverte.</p>
{{end}}

<h2>Veille menaces ({{len .CTI}})</h2>
<p class="muted">{{.CTIScope}}</p>
{{if .CTI}}
<ul>
{{range .CTI}}
<li>{{if .Link}}<a href="{{.Link}}" rel="noopener noreferrer" target="_blank">{{.Title}}</a>{{else}}{{.Title}}{{end}}
<small class="muted">— {{.FeedName}}, {{date .Published}}{{with countries .Countries}} · {{.}}{{end}}{{with sectors .Sectors}} · {{.}}{{end}}</small></li>
{{end}}
</ul>
{{else}}
<p>Aucune actualité correspondante sur la période.</p>
{{end}}

<h2>Veille réglementaire ({{len .Regulatory}})</h2>
<p class="muted">{{.RegScope}}</p>
{{if .Regulatory}}
<ul>
{{range .Regulatory}}
<li>{{if .Link}}<a href="{{.Link}}" rel="noopener noreferrer" target="_blank">{{.Title}}</a>{{else}}{{.Title}}{{end}}
<small class="muted">— {{.FeedName}}, {{date .Published}} · {{regs .Regulations}}</small></li>
{{end}}
</ul>
{{else}}
<p>Aucune actualité réglementaire sur la période.</p>
{{end}}
</section>

{{/* lines: a list cut to maxListed lines, then how many it leaves out and a link to all of them.
   Data: listed. */}}
{{define "lines"}}{{$l := .}}
{{- if $l.Lines}}
<ul>
{{range $l.Lines}}<li><span class="level level-{{level .Finding}}">{{levelName (level .Finding)}}</span> <span class="sev sev-{{band .Finding}}">{{sevLabel (band .Finding)}}</span>{{with reason .Finding}} · <span class="reason">{{.}}</span>{{end}}
  <a href="/findings/{{.ID}}">{{.VulnID}}</a>{{with aliases .Aliases}} <small>({{.}})</small>{{end}} — <a href="/assets/{{.AssetID}}">{{.AssetName}} {{.AssetVersion}}</a>
  {{- if .ShowDue}} — échéance {{day .Finding.Due}}{{end}}{{if .New}} <small class="muted">nouvelle</small>{{end}}</li>
{{end}}{{with $l.More}}<li class="muted">… et {{.}} autres : <a href="{{$l.Link}}">{{$l.Name}}</a></li>{{end}}
</ul>
{{- else}}{{with $l.Empty}}
<p>{{.}}</p>{{end}}{{end}}
{{end}}

{{define "breakdown"}}
<table class="breakdown">
<thead><tr><th>Éditeur</th><th class="num">Urgentes</th><th class="num">Critiques</th><th class="num">Hautes</th><th class="num">Moyennes</th><th class="num">Basses</th><th class="num">Inconnues</th><th class="num">Total</th></tr></thead>
<tbody>
{{range .Groups}}<tr><td>{{.Vendor}}</td><td class="num">{{if .Urgent}}{{.Urgent}}{{else}}<span class="muted">0</span>{{end}}</td>{{range .Bands}}<td class="num">{{if .}}{{.}}{{else}}<span class="muted">0</span>{{end}}</td>{{end}}<td class="num">{{.N}}</td></tr>
{{end}}</tbody>
<tfoot><tr><th>Total</th><th class="num">{{.Total.Urgent}}</th>{{range .Total.Bands}}<th class="num">{{.}}</th>{{end}}<th class="num">{{.Total.N}}</th></tr></tfoot>
</table>
{{end}}
