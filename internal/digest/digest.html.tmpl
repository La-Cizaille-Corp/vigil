<section class="digest">
<p>Généré le {{date .GeneratedAt}} — période depuis le {{date .Since}}.</p>

<h2>Nouvelles vulnérabilités ({{len .New.Total.Findings}})</h2>
{{if .New.Groups}}
{{template "breakdown" .New}}
{{range .New.Groups}}
<h3>{{.Vendor}} ({{len .Findings}})</h3>
<p class="muted">{{.Summary}}</p>
<table>
<thead><tr><th>Sévérité</th><th>Vulnérabilité</th><th>Actif</th><th>Statut</th><th>Résumé</th></tr></thead>
<tbody>
{{range .Findings}}
<tr>
<td>{{if .KEV}}<span class="kev">Exploitée</span><br>{{end}}<span class="sev sev-{{band .}}">{{sev (band .)}}</span>{{with score .CVSS}} <small>CVSS {{.}}</small>{{end}}{{with epss .EPSS}}<br><small>EPSS {{.}}</small>{{end}}</td>
<td><a href="/findings/{{.ID}}">{{.VulnID}}</a>{{if .Aliases}}<br><small>{{join .Aliases ", "}}</small>{{end}}</td>
<td><a href="/assets/{{.AssetID}}">{{.AssetName}} {{.AssetVersion}}</a></td>
<td>{{status .Status}}</td>
<td>{{.Summary}}</td>
</tr>
{{end}}
</tbody>
</table>
{{end}}
{{else}}
<p>Aucune nouvelle vulnérabilité sur la période.</p>
{{end}}

{{if .Overdue}}
<h2>Hors délai de traitement ({{len .Overdue}})</h2>
<ul>
{{range .Overdue}}
<li><span class="sev sev-{{band .}}">{{sev (band .)}}</span>{{if .KEV}} <span class="kev">Exploitée</span>{{end}} <a href="/findings/{{.ID}}">{{.VulnID}}</a> — {{.AssetName}} {{.AssetVersion}} — échéance {{.Due.Format "02/01/2006"}}</li>
{{end}}
</ul>
{{end}}

{{if .Concerning}}
<h2>Actualités citant vos vulnérabilités ({{len .Concerning}})</h2>
<ul>
{{range .Concerning}}
<li>{{if .Link}}<a href="{{.Link}}" rel="noopener noreferrer" target="_blank">{{.Title}}</a>{{else}}{{.Title}}{{end}}
<small class="muted">— {{.FeedName}}, {{date .Published}} · {{join .Concerns ", "}}</small></li>
{{end}}
</ul>
{{end}}

<h2>Vulnérabilités ouvertes ({{len .Open.Total.Findings}})</h2>
{{if .Open.Groups}}
{{template "breakdown" .Open}}
{{range .Open.Groups}}
<h3>{{.Vendor}} ({{len .Findings}})</h3>
<p class="muted">{{.Summary}}</p>
<ul>
{{range .Listed}}
<li>{{if .KEV}}<span class="kev">Exploitée</span> {{end}}<span class="sev sev-{{band .}}">{{sev (band .)}}</span>{{with score .CVSS}} <small>CVSS {{.}}</small>{{end}}{{with epss .EPSS}} <small>EPSS {{.}}</small>{{end}} <a href="/findings/{{.ID}}">{{.VulnID}}</a> — {{.AssetName}} {{.AssetVersion}} — {{status .Status}}</li>
{{end}}
{{with .Unlisted}}<li class="muted">… et {{.}} autres, moins sévères, à consulter dans la liste des vulnérabilités</li>{{end}}
</ul>
{{end}}
{{else}}
<p>Aucune vulnérabilité ouverte.</p>
{{end}}

<h2>Synthèse par statut</h2>
<ul>
{{range .Counts}}<li>{{status .Status}} : {{.N}}</li>{{end}}
</ul>

<h2>Veille menaces ({{len .CTI}})</h2>
<p class="muted">{{.CTIScope}}</p>
{{if .CTI}}
<ul>
{{range .CTI}}
<li>{{if .Link}}<a href="{{.Link}}" rel="noopener noreferrer" target="_blank">{{.Title}}</a>{{else}}{{.Title}}{{end}}
<small class="muted">— {{.FeedName}}, {{date .Published}}{{with countries .Countries}} · {{.}}{{end}}{{with sectors .Sectors}} · {{.}}{{end}}</small></li>
{{end}}
</ul>
{{else}}
<p>Aucune actualité correspondante sur la période.</p>
{{end}}

<h2>Veille réglementaire ({{len .Regulatory}})</h2>
<p class="muted">{{.RegScope}}</p>
{{if .Regulatory}}
<ul>
{{range .Regulatory}}
<li>{{if .Link}}<a href="{{.Link}}" rel="noopener noreferrer" target="_blank">{{.Title}}</a>{{else}}{{.Title}}{{end}}
<small class="muted">— {{.FeedName}}, {{date .Published}} · {{regs .Regulations}}</small></li>
{{end}}
</ul>
{{else}}
<p>Aucune actualité réglementaire sur la période.</p>
{{end}}
</section>

{{define "breakdown"}}
<table class="breakdown">
<thead><tr><th>Éditeur</th><th class="num">Critiques</th><th class="num">Hautes</th><th class="num">Moyennes</th><th class="num">Basses</th><th class="num">Inconnues</th><th class="num">Total</th><th class="num">Exploitées (KEV)</th></tr></thead>
<tbody>
{{range .Groups}}<tr><td>{{.Vendor}}</td>{{range .Bands}}<td class="num">{{if .}}{{.}}{{else}}<span class="muted">0</span>{{end}}</td>{{end}}<td class="num">{{len .Findings}}</td><td class="num">{{if .KEV}}{{.KEV}}{{else}}<span class="muted">0</span>{{end}}</td></tr>
{{end}}</tbody>
<tfoot><tr><th>Total</th>{{range .Total.Bands}}<th class="num">{{.}}</th>{{end}}<th class="num">{{len .Total.Findings}}</th><th class="num">{{.Total.KEV}}</th></tr></tfoot>
</table>
{{end}}
