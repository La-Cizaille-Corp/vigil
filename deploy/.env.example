# Copy to .env (never commit .env). Every "serve" option can be set here as
# VIGIL_<OPTION>, e.g. -sync-interval -> VIGIL_SYNC_INTERVAL.

# Public name of the server; Caddy requests its certificate.
VIGIL_DOMAIN=vigil.example.org

# Optional free NVD API key (faster CPE matching):
# https://nvd.nist.gov/developers/request-an-api-key
VIGIL_NVD_API_KEY=

VIGIL_SYNC_INTERVAL=6h
VIGIL_DIGEST_INTERVAL=24h
VIGIL_BACKUP_INTERVAL=24h
VIGIL_BACKUP_KEEP=14
